default_platform(:ios)

platform :ios do
  def fetch_app_store_api_key
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: false
    )
  end

  desc "Sync code signing assets via match (type: development|adhoc|appstore)"
  lane :sync_signing do |options|
    api_key = fetch_app_store_api_key

    match(
      type: (options[:type] || "appstore"),
      readonly: (options[:readonly] == true || options[:readonly].to_s == "true"),
      force: (options[:force] == true || options[:force].to_s == "true"),
      app_identifier: [
        "com.a2006mike.MyTaiwanStock",
        "com.a2006mike.MyTaiwanStock.StockWidget",
        "com.a2006mike.MyTaiwanStock.LiveActivity"
      ],
      api_key: api_key
    )
  end

  desc "Build and upload a new TestFlight beta build"
  lane :beta do
    api_key = fetch_app_store_api_key

    match(
      type: "appstore",
      readonly: false,
      app_identifier: [
        "com.a2006mike.MyTaiwanStock",
        "com.a2006mike.MyTaiwanStock.StockWidget",
        "com.a2006mike.MyTaiwanStock.LiveActivity"
      ],
      api_key: api_key
    )

    # latest_testflight_build_number filters App Store Connect builds by
    # processingState "PROCESSING,FAILED,COMPLETE", which does not include
    # "VALID" -- the state every build in this app's history actually has.
    # That made it find nothing and fall back to 1, colliding with builds
    # already uploaded years ago under earlier marketing versions. Query
    # every build ever uploaded for this app, across all versions and
    # states, and take the true historical maximum instead.
    require 'spaceship'
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    asc_app = Spaceship::ConnectAPI::App.find("com.a2006mike.MyTaiwanStock")
    all_builds = Spaceship::ConnectAPI::Build.all(app_id: asc_app.id, limit: 200)
    latest_build = all_builds.map { |b| b.version.to_i }.max || 0

    next_build_number =
      if latest_build.zero?
        get_build_number(xcodeproj: "MyTaiwanStock.xcodeproj").to_i
      else
        latest_build + 1
      end

    increment_build_number(
      build_number: next_build_number,
      xcodeproj: "MyTaiwanStock.xcodeproj"
    )

    build_app(
      scheme: "MyTaiwanStock",
      export_method: "app-store"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
